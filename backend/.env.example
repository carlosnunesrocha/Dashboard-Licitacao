# Copie para .env e preencha. O .env NÃO vai para o repositório.

# --- Banco ---------------------------------------------------------------
# SQLite em dev (não há Docker Desktop na máquina de desenvolvimento).
# Em produção, trocar o provider do schema.prisma para postgresql.
DATABASE_URL="file:./dev.db"

# --- Servidor ------------------------------------------------------------
PORT=3001
# Precisa bater com a porta do Vite, senão o navegador bloqueia as chamadas.
CORS_ORIGIN="http://localhost:5173"

# --- JWT -----------------------------------------------------------------
# Gere valores longos e aleatórios. NÃO reaproveite entre ambientes.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_SECONDS=604800

# --- Caixa Escolar (SGD/MG) ----------------------------------------------
# API REST com login direto: POST /auth/login {txCpfCnpj, txPassword}
CAIXA_ESCOLAR_USER=
CAIXA_ESCOLAR_PASS=

# --- LicitarDigital ------------------------------------------------------
# O adaptador usa o TOKEN, não usuário/senha: o login é OAuth2 atrás de
# Cloudflare e ainda não foi automatizado.
#
# Como obter: logar no portal como fornecedor, abrir o Console (F12) em
# app2.licitardigital.com.br e rodar:
#     copy(localStorage.getItem("_LDToken"))
# Use copy(), não selecione o texto — o DevTools abrevia strings longas com
# reticências e o valor sai truncado.
#
# O JWT não tem claim exp, então é longevo. Se o sync passar a responder
# "token rejeitado", gere outro do mesmo jeito.
LICITAR_DIGITAL_TOKEN=

# Visão canônica: favorite (padrão) | proposal.
# NÃO troque sem intenção: marcarDesaparecidos escopa o portal inteiro, então
# cada troca move dezenas de licitações para dentro ou fora do board.
LICITAR_DIGITAL_FILTRO=favorite

# Guardados para quando o login automatizado for implementado. O adaptador
# atual não os lê.
LICITAR_DIGITAL_USER=
LICITAR_DIGITAL_PASS=

# --- Portais ainda não integrados ----------------------------------------
# Login automatizado bloqueado: reCAPTCHA Enterprise + teclado virtual de
# senha com botões ambíguos. Ver PROGRESS.md.
BNC_COMPRAS_USER=
BNC_COMPRAS_PASS=
BLL_COMPRAS_USER=
BLL_COMPRAS_PASS=

# --- PNCP (adaptador desativado) -----------------------------------------
# Existe em integrations/pncp/ mas está fora de PORTAL_ADAPTERS: a API
# pública não informa se a empresa participa, então só traria prospecção.
PNCP_SEARCH_QUERY=
PNCP_SYNC_WINDOW_DAYS=30
PNCP_MAX_ITEMS=500
